  "term_lines": {"at": {"within": [30, 400, 100, 595], "page": 1, "all": true}, "rows": "[str(t.get('line', '')) for t in (v.terms or [])]"},
  "term_text": {"at": {"within": [105, 400, 580, 595], "page": 1, "all": true}, "rows": "[t['text'] for t in (v.terms or [])]"},
  "deadline": {"at": {"label": "to all parties on or before"}, "value": "when(v.deadline) if v.deadline else None"}
 }
